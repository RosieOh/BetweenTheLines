# Giscus 댓글 (https://giscus.app 에서 발급)
VITE_GISCUS_REPO_ID=R_kgDOxxxxxxxxxx
VITE_GISCUS_CATEGORY_ID=DIC_kwDOxxxxxxxxxx

# 배포 주소 — sitemap / robots / prerender 가 참조합니다.
# GitHub Pages 프로젝트 사이트 기준이며 CI(.github/workflows/deploy-pages.yml)에서 주입됩니다.
# 커스텀 도메인으로 옮길 때는 SITE_ORIGIN 을 바꾸고 VITE_BASE_PATH 를 / 로 되돌리세요.
SITE_ORIGIN=https://rosieoh.github.io
VITE_BASE_PATH=/BetweenTheLines/

# 관리자 앱(apps/admin)의 "블로그 보기" 링크가 가리킬 주소.
# 생략하면 개발 서버 기본값(http://localhost:8080)을 씁니다.
VITE_BLOG_URL=http://localhost:8080
